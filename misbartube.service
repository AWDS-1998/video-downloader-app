[Unit]
Description=Video Downloader Backend
After=network.target

[Service]
WorkingDirectory=/var/www/video-downloader-app/backend
ExecStart=/usr/bin/npm start
Restart=always
User=root
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=YOUTUBE_API_KEY=
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/root/.deno/bin

[Install]
WantedBy=multi-user.target
